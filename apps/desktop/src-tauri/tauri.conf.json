{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuck DDL",
  "version": "0.2.0",
  "identifier": "com.fuckddl.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../ --filter @fuck-ddl/web dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../../ --filter @fuck-ddl/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fuck DDL",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:fuck-ddl.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
