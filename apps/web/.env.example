# Public browser configuration only. Never put the Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Web callback only. Desktop OAuth uses http://127.0.0.1:43123/auth/callback.
# Must be listed in Supabase Auth > URL Configuration > Redirect URLs when used.
VITE_AUTH_REDIRECT_URL=https://your-web-domain.example/auth/callback
