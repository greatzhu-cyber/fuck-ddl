{
  "manifest_version": 3,
  "name": "Fuck DDL Focus Guard",
  "description": "只在本机统计活动域名，并在非白名单网站连续停留 10 分钟后暂停专注。",
  "version": "0.1.0",
  "permissions": ["alarms", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fuck DDL Focus Guard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
